{
  "name": "pi-ask",
  "version": "1.0.0",
  "description": "Interactive ask_user tool for Pi: ask the user a question with options, multi-select, batches and free-form answers.",
  "type": "module",
  "license": "MIT",
  "author": "Raidel Martínez Santos <yoshilol0526@gmail.com>",
  "homepage": "https://github.com/YoshiLoL0526/pi-ask#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoshiLoL0526/pi-ask.git"
  },
  "bugs": {
    "url": "https://github.com/YoshiLoL0526/pi-ask/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "ask",
    "ask_user",
    "interactive"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ]
